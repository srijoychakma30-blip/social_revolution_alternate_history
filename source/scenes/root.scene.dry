on-arrival: {!
Q.started = 1;
// time elapsed (in months)
Q.time = 1;
Q.year = 1962;
Q.month = 2;
Q.month_actions = 0;

// 0 = normal difficulty, 1 = hard mode, 2 = hard mode no saves
Q.difficulty = 0;
Q.historical_mode = 0;

// party resources
// resources = cadres, money, safe houses, printing presses
Q.resources = 2;
// dues = monthly income from union cells and sympathizers
Q.dues = 2;

// === PARTY STATE ===
// overall dissent reduces every increase in mass support
Q.dissent = 0.05;
Q.dissent_percent = 5;

// === INTERNAL FACTIONS ===
// Maoists - insurrectionary purists, protracted people's war, base areas in the countryside
// led broadly by Amazonas and Grabois
Q.factions = ['maoist', 'urban', 'gradualist', 'youth'];
Q.maoist_strength = 35;
Q.maoist_dissent = 10;
// Urban Insurrectionists - foco theory, cities first, influenced by Cuba
Q.urban_strength = 25;
Q.urban_dissent = 15;
// Gradualists - build mass organizations first, let conditions ripen
Q.gradualist_strength = 20;
Q.gradualist_dissent = 20;
// Youth Militants (UJC cadres, student movement) - most radical, most impatient
Q.youth_strength = 20;
Q.youth_dissent = 25;

// === SECRET FACTION EVENTS ===
Q.maoists_split = 0;
Q.gradualists_expelled = 0;
Q.youth_insurrection = 0;
Q.urban_foco_launched = 0;

// === IDEOLOGY & STRATEGY DIALS ===
// radicalization: how militant is the party's public posture (0-10)
Q.radicalization = 3;
// maoist_line: how committed to Mao Zedong Thought (0-10)
Q.maoist_line = 2;
// armed_struggle: how far along the path to open guerrilla war (0-10)
Q.armed_struggle = 0;
// collaboration: willingness to work with Goulart's government (0-10)
Q.collaboration = 1;
// land_agitation: how actively we are organizing the peasant leagues (0-10)
Q.land_agitation = 0;
// union_work: how deeply embedded in the urban labor movement (0-10)
Q.union_work = 1;
// clandestine_security: how secure our cell network is (0-10)
