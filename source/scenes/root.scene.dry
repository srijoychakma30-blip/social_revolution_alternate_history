// 3 = protracted people's war (Maoist plan - base areas, peasant army, Araguaia)
Q.strategic_plan = 0;
Q.mass_base_adopted = 0;
Q.foco_adopted = 0;
Q.protracted_war_adopted = 0;
// support for each plan
Q.mass_base_support = 2;
Q.foco_support = 2;
Q.protracted_war_support = 3;
