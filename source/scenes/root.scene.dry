Q.araguaia_project = 0;
Q.araguaia_cadres = 0;
Q.araguaia_column_formed = 0;
Q.araguaia_strength = 0;
Q.araguaia_exposed = 0;

// === ARMED FORCES ===
// PCdoB armed cadres (in hundreds - we are very small in 1962)
Q.pcdb_militia_strength = 0.5;
Q.pcdb_militia_discipline = 0.6;
// Peasant Leagues (Ligas Camponesas) - Julião's movement, not ours but allied
Q.leagues_militia_strength = 8;
Q.leagues_militia_discipline = 0.3;
// CGT/union self-defense groups
Q.union_militia_strength = 3;
Q.union_militia_discipline = 0.4;
// Brazilian Army - the decisive factor
Q.army_strength = 180;
Q.army_militancy = 5;
// coup faction within the army (ESG doctrine, UDN-aligned officers)
Q.coup_faction_strength = 0.45;
// nationalist faction within the army (sympathetic to Goulart)
Q.nationalist_faction_strength = 0.35;
